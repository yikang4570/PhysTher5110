# --- Add group labels manually on axis ---
# Group boundaries and names
group_boundaries <- c(3, 7, 21)  # after Pathology (3 vars), Mechanics (4 vars), then Collagen alignment (14 vars)
group_names <- c("Pathology", "Mechanics", "Collagen alignment")
# Add divider lines
abline(v = group_boundaries + 0.5, col = "grey40", lwd = 1)
abline(h = group_boundaries + 0.5, col = "grey40", lwd = 1)
# Add text labels for groups (top axis)
text(x = c(2, 5, 14.5), y = 22.3, labels = group_names,
cex = 0.8, font = 2)
# Add mirrored labels for y-axis
text(x = -0.5, y = c(2, 5, 14.5), labels = group_names,
cex = 0.8, font = 2, srt = 90)
# Instrumentation Assignment ---------------------------------------------------
#Question 1
DATA1 <- read.csv("/Users/yikang/Documents/GitHub/PhysTher5110/data/data_overall_tendon_muscle.csv")
corrplot(
cor_matrix,
method = "color",
type = "upper",                # only upper triangle
order = "original",            # keep your order
addCoef.col = "black",         # show correlation coefficients
number.cex = 0.4,              # adjust text size
tl.cex = 0.6,                  # axis label size
tl.col = "black",
tl.srt = 45,
diag = TRUE,
col = col_corr,
mar = c(0.01,0.01,0.01,0.01)
)
# StdAoP long
std_long <- DATA1 %>%
select(ID, Total.Pathological, AF_Neuropathy, starts_with("StdAoP")) %>%
pivot_longer(starts_with("StdAoP"),
names_to = "Position", values_to = "StdAoP") %>%
mutate(
Position = readr::parse_number(Position),
Position = factor(Position, levels = 1:7, labels = paste0("P", 1:7)),
zPath = as.numeric(scale(Total.Pathological)),
zNeuro = as.numeric(scale(AF_Neuropathy))
)
# DoLP long
dolp_long <- DATA1 %>%
select(ID, Total.Pathological, AF_Neuropathy, starts_with("DoLP")) %>%
pivot_longer(starts_with("DoLP"),
names_to = "Position", values_to = "DoLP") %>%
mutate(
Position = readr::parse_number(Position),
Position = factor(Position, levels = 1:7, labels = paste0("P", 1:7)),
zPath = as.numeric(scale(Total.Pathological)),
zNeuro = as.numeric(scale(AF_Neuropathy))
)
# StdAoP-----------------------------
# Candidate models (ML for comparison)
m0_std <- lmer(StdAoP ~ Position + (1|ID), data = std_long, REML = FALSE)
library(lme4)
library(lmerTest)       # p-values for lmer
library(broom.mixed)    # tidy model summaries
library(performance)    # BIC, R2, diagnostics
library(DHARMa)         # residual diagnostics for (G)LMMs
# StdAoP long
std_long <- DATA1 %>%
select(ID, Total.Pathological, AF_Neuropathy, starts_with("StdAoP")) %>%
pivot_longer(starts_with("StdAoP"),
names_to = "Position", values_to = "StdAoP") %>%
mutate(
Position = readr::parse_number(Position),
Position = factor(Position, levels = 1:7, labels = paste0("P", 1:7)),
zPath = as.numeric(scale(Total.Pathological)),
zNeuro = as.numeric(scale(AF_Neuropathy))
)
# DoLP long
dolp_long <- DATA1 %>%
select(ID, Total.Pathological, AF_Neuropathy, starts_with("DoLP")) %>%
pivot_longer(starts_with("DoLP"),
names_to = "Position", values_to = "DoLP") %>%
mutate(
Position = readr::parse_number(Position),
Position = factor(Position, levels = 1:7, labels = paste0("P", 1:7)),
zPath = as.numeric(scale(Total.Pathological)),
zNeuro = as.numeric(scale(AF_Neuropathy))
)
# StdAoP-----------------------------
# Candidate models (ML for comparison)
m0_std <- lmer(StdAoP ~ Position + (1|ID), data = std_long, REML = FALSE)
m0_std
# StdAoP-----------------------------
# Candidate models (ML for comparison)
m0<- lmer(StdAoP ~ 1 +(1|ID), data=std_long, REML = FALSE)
m0
anova(m0,mo_std)
anova(m0,m0_std)
m1_std <- lmer(StdAoP ~ Position + zPath + (1|ID), data = std_long, REML = FALSE)
m2_std <- lmer(StdAoP ~ Position + zPath + zNeuro + (1|ID), data = std_long, REML = FALSE)
m3_std <- lmer(StdAoP ~ Position + zPath * zNeuro + (1|ID), data = std_long, REML = FALSE)
#Try random slope for Position if you have enough IDs:
m3s_std <- lmer(StdAoP ~ Position + zPath * zNeuro + (1 + Position | ID), data = std_long, REML = FALSE)
# Compare by BIC (lower is better)
bic_tab_std <- performance::compare_performance(m0_std, m1_std, m2_std, m3_std, metrics = "BIC") %>%
arrange(BIC)
bic_tab_std
best_std_ml <- list(m0_std, m1_std, m2_std, m3_std)[[which.min(c(BIC(m0_std), BIC(m1_std), BIC(m2_std), BIC(m3_std)))]]
anova(m0_std,m1_std)
anova(m1_std,m2_std)
anova(m1_std,m3_std)
m1_std
m1_2 <- lmer(StdAoP ~  zPath + (1|ID), data = std_long, REML = FALSE)
anova(m1_2,m1_std)
summary(m1_std)
# Packages
library(emmeans)
library(ggplot2)
# Estimated marginal means across positions
emm_pos <- emmeans(m1_std, ~ Position)
# Plot with 95% CI
plot(emm_pos, comparisons = TRUE) +
labs(
x = "Position (P1–P7)",
y = "Predicted StdAoP (degrees)"
) +
ggtitle("Estimated StdAoP Across Tendon Positions") +
theme_bw(base_size = 14) +
theme(plot.title = element_text(hjust = 0.5, face = "bold"))"
#Try random slope for Position if you have enough IDs:
m3s_std <- lmer(StdAoP ~ Position + zPath * zNeuro + (1 + Position | ID), data = std_long, REML = FALSE)
# Compare by BIC (lower is better)
bic_tab_std <- performance::compare_performance(m0_std, m1_std, m2_std, m3_std, metrics = "BIC") %>%
# Plot with 95% CI
plot(emm_pos, comparisons = TRUE) +
labs(
x = "Position (P1–P7)",
y = "Predicted StdAoP (degrees)"
) +
ggtitle("Estimated StdAoP Across Tendon Positions") +
theme_bw(base_size = 14) +
theme(plot.title = element_text(hjust = 0.5, face = "bold"))
# Create a prediction grid over pathology values
pred_data <- ggeffects::ggpredict(m1_std, terms = c("zPath [all]"))
# Plot the fitted line
plot(pred_data) +
labs(
x = "Standardized Total Pathology (z-score)",
y = "Predicted StdAoP (degrees)"
) +
ggtitle("Predicted Relationship Between Pathology and Collagen Alignment") +
theme_bw(base_size = 14) +
theme(plot.title = element_text(hjust = 0.5, face = "bold"))
# Combined
# Interaction plot (if you later include zPath * Position)
pred_interact <- ggeffects::ggpredict(m1_std, terms = c("zPath", "Position"))
ggplot(pred_interact, aes(x = x, y = predicted, color = group)) +
geom_line(size = 1) +
geom_ribbon(aes(ymin = conf.low, ymax = conf.high, fill = group), alpha = 0.15) +
scale_color_brewer(palette = "Dark2", name = "Position") +
scale_fill_brewer(palette = "Dark2", name = "Position") +
labs(
x = "Standardized Total Pathology (z-score)",
y = "Predicted StdAoP (degrees)"
) +
ggtitle("Predicted StdAoP Across Pathology Levels and Tendon Positions") +
theme_bw(base_size = 13) +
theme(
legend.position = "right",
plot.title = element_text(hjust = 0.5, face = "bold")
)
bic_tab_std
# Refit best with REML for final inference
form_best_std <- formula(best_std_ml)
best_std <- lmer(form_best_std, data = std_long, REML = TRUE)
summary(best_std)
performance::r2(best_std)       # marginal/conditional R2
# Residual diagnostics (DHARMa)
sim_std <- DHARMa::simulateResiduals(best_std, n = 1000)
plot(sim_std)                 # uniformity, QQ, dispersion
# Classic residual plots
par(mfrow = c(1,2))
plot(fitted(best_std), resid(best_std), pch = 19, cex = 0.6,
xlab = "Fitted", ylab = "Residuals", main = "Residuals vs Fitted")
abline(h = 0, col = "red")
qqnorm(resid(best_std)); qqline(resid(best_std), col = "red")
par(mfrow = c(1,1))
# Residuals by Position
std_long$.resid <- resid(best_std)
ggplot(std_long, aes(Position, .resid)) +
geom_violin(fill = "grey85", color = "grey40") +
geom_hline(yintercept = 0, color = "red", linetype = 2) +
theme_bw() +
labs(y = "Residuals", x = "Position")
