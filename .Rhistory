)
# Nice display names matching your request
vars_display <- c(
# Pathology
"Total pathology(%)", "ECM", "Neuropathy",
# Mechanics
"Linear modulus", "Hysteresis", "Percent relaxation", "Equilibrium stress",
# Collagen alignment
paste0("StdAoP", 1:7),
paste0("DoLP", 1:7)
)
# --- Compute correlation matrix ---
cor_matrix <- DATA1 %>%
select(all_of(vars_internal)) %>%
cor(use = "pairwise.complete.obs", method = "pearson")
# Rename rows/cols
rownames(cor_matrix) <- vars_display
colnames(cor_matrix) <- vars_display
# --- Define color-blind-friendly diverging palette (blue-white-red) ---
col_corr <- colorRampPalette(c("#4575B4", "white", "#D73027"))(200)
corrplot(
cor_matrix,
method = "color",
type = "upper",                # only upper triangle
order = "original",            # keep your order
addCoef.col = "black",         # show correlation coefficients
number.cex = 0.6,              # adjust text size
tl.cex = 0.7,                  # axis label size
tl.col = "black",
tl.srt = 45,
diag = TRUE,
col = col_corr,
mar = c(0.5,0.5,0.5,0.5)
)
