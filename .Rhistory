#Task 7
set.seed(1204)
# Define grade levels
grades <- c(9, 10, 11)
# Number of students per grade
n_students <- 10
# Simulate student names (just Student1, Student2,... for simplicity)
student_names <- paste0("Student", 1:n_students)
student_names
# build up an empty dataset
students_10 <- data.frame(
name = character(0),
grade = integer(0),
arithmetic_score = numeric(0),
algebra_score = numeric(0)
)
# build up an empty dataset
students <- data.frame(
name = character(0),
grade = integer(0),
arithmetic_score = numeric(0),
algebra_score = numeric(0)
)
#generate the scores
ari_scores <- rnorm(n_students, mean = 75, sd = 10)
ari_scores
#generate the scores
ari_scores <- pmin(rnorm(n_students, mean = 75, sd = 10),100)
ari_scores
#generate the normalized scores
ari_scores <- pmin(as.integer(rnorm(n_students, mean = 75, sd = 10)),100)
alg_scores <- pmin(as.integer(rnorm(n_students, 64, 10)), 100)
alg_scores
#Plot the variables
#14
# Plot arithmetic scores
plot(grades, ari_scores, type = "b", col = "blue", pch = 19,
ylim = c(60, 100), xlab = "Grade", ylab = "Test Score",
main = "Arithmetic vs Algebra Scores by Grade")
#Plot the variables
#14
# Plot arithmetic scores
plot(students$grade, students$ari_scores, type = "b", col = "blue", pch = 19,
ylim = c(60, 100), xlab = "Grade", ylab = "Test Score",
main = "Arithmetic vs Algebra Scores by Grade")
#generate the normalized scores
ari_scores <- pmin(as.integer(rnorm(n_students, mean = 75, sd = 10)),100)
alg_scores <- pmin(as.integer(rnorm(n_students, 64, 10)), 100)
#Update the data frame
students <- data.frame(
name = rep(student_names, length(grades)),
grade = rep(grades, each = length(student_names)),
ari_scores = ari_scores,
alg_scores = alg_scores
)
students
#Plot the variables
#14
# Plot arithmetic scores
plot(students$grade, students$ari_scores, type = "b", col = "blue", pch = 19,
ylim = c(60, 100), xlab = "Grade", ylab = "Test Score",
main = "Arithmetic vs Algebra Scores by Grade")
# Add algebra scores
points(grades, alg_scores, type = "b", col = "red", pch = 17)
# Add algebra scores
points(students$grade, students$alg_scores, type = "b", col = "red", pch = 17)
# Add legend
legend("topleft", legend = c("Arithmetic", "Algebra"),
col = c("blue", "red"), pch = c(19, 17), lty = 1)
