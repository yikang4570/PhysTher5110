annotate("text", x = (bound_path + bound_mech) / 2, y = length(vars_display) + 1,
label = "Mechanics", size = 3, fontface = "bold", hjust = 0.5) +
annotate("text", x = (bound_mech + length(vars_display) + 0.5) / 2,
y = length(vars_display) + 1,
label = "Collagen alignment", size = 3, fontface = "bold", hjust = 0.5)
# IMPORTANT: ensure the upper-triangle right-angle is at the TOP-RIGHT
# (with i <= j above and your factor order, this produces the desired orientation)
pA <- pA + coord_cartesian(clip = "off") +
theme(plot.margin = margin(20, 20, 5, 5))
pA
# tidy and keep upper triangle INCLUDING diagonal (i <= j)
df <- as.data.frame(as.table(cor_mat)) %>%
rename(Var1 = Var1, Var2 = Var2, r = Freq) %>%
inner_join(as.data.frame(as.table(p_mat)) %>%
rename(Var1 = Var1, Var2 = Var2, p = Freq),
by = c("Var1","Var2")) %>%
mutate(
i = match(Var1, vars_display),
j = match(Var2, vars_display)
) %>%
filter(i >= j) %>%                                  # keep diagonal back
mutate(
Var1 = factor(Var1, levels = vars_display),
Var2 = factor(Var2, levels = vars_display),
# stacked-star labels
sig_label = dplyr::case_when(
#p < 0.001 ~ "*\n*\n*",
p < 0.01  ~ "**",
p < 0.05  ~ "*",
TRUE      ~ ""
)
)
# -------- group boundaries (based on your conceptual order) --------
n_pathology <- 3
n_mechanics <- 4
n_collagen  <- 14
bound_path  <- n_pathology + 0.5
bound_mech  <- n_pathology + n_mechanics + 0.5
N           <- length(vars_display)
# midpoints for left-side group labels
mid_path <- n_pathology/2
mid_mech <- n_pathology + n_mechanics/2
mid_coll <- n_pathology + n_mechanics + n_collagen/2
# -------- heatmap --------
pA <- ggplot(df, aes(x = Var2, y = Var1, fill = r)) +
geom_tile() +
# stacked significance stars
geom_text(aes(label = sig_label),
size = 3, color = "black", lineheight = 0.8, fontface = "bold") +
# dashed group separators
geom_hline(yintercept = bound_path, linetype = "dashed", linewidth = 0.4) +
geom_hline(yintercept = bound_mech,  linetype = "dashed", linewidth = 0.4) +
geom_vline(xintercept = bound_path, linetype = "dashed", linewidth = 0.4) +
geom_vline(xintercept = bound_mech,  linetype = "dashed", linewidth = 0.4) +
# dashed main diagonal (from bottom-left to top-right)
annotate("segment",
x = 0.5, y = 0.5, xend = N + 0.5, yend = N + 0.5,
linetype = "dashed", linewidth = 0.5, color = "black") +
# color scale
scale_fill_gradient2(
name  = "Pearson r",
low   = "#4575B4", mid = "white", high = "#D73027",
limits = c(-1, 1), oob = scales::squish
) +
coord_equal(clip = "off") +   # allow drawing outside for left labels
labs(x = NULL, y = NULL) +
theme_minimal(base_size = 10) +
theme(
axis.text.x = element_text(angle = 45, hjust = 1, vjust = 1, size = 7),
axis.text.y = element_text(size = 7),
panel.grid  = element_blank(),
plot.margin = margin(5, 30, 5, 60),  # extra LEFT margin for group labels
legend.position = "right",
# vertical legend title beside color bar:
legend.title = element_text(vjust = 0.5)
) +
# -------- TOP-side group labels in the blank margin --------
annotate("text", x = bound_path / 2, y = length(vars_display) + 1,
label = "Pathology", size = 3, fontface = "bold", hjust = 0.5) +
annotate("text", x = (bound_path + bound_mech) / 2, y = length(vars_display) + 1,
label = "Mechanics", size = 3, fontface = "bold", hjust = 0.5) +
annotate("text", x = (bound_mech + length(vars_display) + 0.5) / 2,
y = length(vars_display) + 1,
label = "Collagen alignment", size = 3, fontface = "bold", hjust = 0.5)
pA
