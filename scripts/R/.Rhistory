#arguments 1 = q; arguments 2 L
forwardkinematics <- function (q, L) {
stopifnot(length(q) == 2, length(L) == 2)
th1 <- q[1]; th2 <- q[2]
L1 <- L[1];  L2 <- L[2]
elbow <- c(L1 * cos(th1), L1 * sin(th1))
hand  <- elbow + c(L2 * cos(th1 + th2), L2 * sin(th1 + th2))}
q<-c(pi/4,pi/3)
L<-c(3.0, 3.2)
elbow
q_test<-c(pi/4,pi/3)
L_test<-c(3.0, 3.2)
forwardkinematics(q=q_test,L=L_test)
print(forwardkinematics(q=q_test,L=L_test))
q_test<-c(pi/4,pi/3)
L_test<-c(3.0, 3.2)
