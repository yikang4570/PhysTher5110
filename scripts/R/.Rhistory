# ---- Consistent color mapping for P1–P7 ----
pos_levels <- paste0("P", 1:7)
out_pdf  <- "tendon_multi_panel_figure.pdf"
# Okabe–Ito (colorblind-friendly) 7-color palette
okabe_ito_7 <- c("#E69F00","#56B4E9","#009E73","#F0E442","#0072B2","#D55E00","#CC79A7")
names(okabe_ito_7) <- pos_levels
# ---- Panel A: Correlation heatmap (upper triangle) ----
vars_internal <- c(
# Pathology (3)
"Total.Pathological", "AF_ECM_SR", "AF_Neuropathy",
# Mechanics (4)
"linMod", "hys", "percRelax", "eqStress",
# Collagen alignment (StdAoP1..7 + DoLP1..7)
paste0("StdAoP", 1:7),
paste0("DoLP", 1:7)
)
vars_display <- c(
"Total pathology", "ECM", "Neuropathy",
"Linear modulus", "Hysteresis", "Percent relaxation", "Equilibrium stress",
paste0("StdAoP", 1:7),
paste0("DoLP", 1:7)
)
# Keep only columns present
vars_present <- vars_internal[vars_internal %in% colnames(DATA1)]
disp_present <- vars_display[match(vars_present, vars_internal)]
# Compute Pearson correlation (pairwise complete)
cor_mat <- cor(DATA1[, vars_present, drop = FALSE],
use = "pairwise.complete.obs", method = "pearson")
# Tidy the matrix and keep the upper triangle
cor_df <- as.data.frame(as.table(cor_mat)) %>%
rename(Var1 = Var1, Var2 = Var2, r = Freq) %>%
mutate(
Var1_lab = disp_present[match(Var1, vars_present)],
Var2_lab = disp_present[match(Var2, vars_present)],
# keep upper triangle: index of Var1 <= index of Var2
i = match(Var1, vars_present),
j = match(Var2, vars_present)
) %>%
filter(i <= j)
library(ggplotify)
library(ggplotify)
# ---- Panel B: DoLP vs Total Pathology ----
pB <- ggplot(dolp_long, aes(x = `Total.Pathological`, y = DoLP, color = Position)) +
geom_point(alpha = 0.75, size = 1.6) +
geom_smooth(aes(group = 1), method = "lm", se = FALSE,
color = "black", linetype = "dashed", linewidth = 0.5) +
scale_color_manual(values = okabe_ito_7) +
labs(
title = "B  DoLP vs. total pathology",
x = "Total pathology (%)",
y = "DoLP (unitless)"
) +
theme_minimal(base_size = 10) +
theme(
legend.position = "top",
legend.title = element_blank(),
plot.title.position = "plot"
)
# ---- Panel C: StdAoP by Position (violin + box + raw points) ----
pC <- ggplot(std_long, aes(x = Position, y = StdAoP, fill = Position)) +
geom_violin(alpha = 0.6, color = "black", width = 0.9) +
# add jittered raw data points
geom_jitter(aes(color = Position),
width = 0.15, size = 1.3, alpha = 0.6, stroke = 0.2) +
geom_boxplot(width = 0.18, outlier.shape = NA,
color = "black", linewidth = 0.3) +
stat_summary(fun = median, geom = "point", size = 1.6, color = "black") +
scale_fill_manual(values = okabe_ito_7) +
scale_color_manual(values = okabe_ito_7) +
labs(
title = "C  StdAoP distribution by tendon position (with raw data)",
x = "Tendon position (P1–P7)",
y = "StdAoP (degrees)"
) +
theme_minimal(base_size = 10) +
theme(
legend.position = "none",
plot.title.position = "plot"
)
# ---- Combine layout ----
final_plot <-
(pA +                         # heatmap on top
plot_layout(widths = 1, heights = 1)) /
((pB + pC) +                  # B + C side-by-side
plot_layout(widths = c(1, 1))) +
plot_layout(heights = c(2.2, 1)) +       # A is ~2× taller than B+C row
plot_annotation(tag_levels = NULL)
# ---- Save output ----
ggsave(
"tendon_multi_panel_figure_layout.pdf",
plot = final_plot,
width = 10, height = 10, units = "in", dpi = 150, device = "pdf"
)
